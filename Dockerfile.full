# syntax=docker/dockerfile:1.4
ARG BASE_IMAGE=kernelmcp-devuser
FROM ${BASE_IMAGE}

ARG USERNAME=devuser
ARG REPO_REF=HEAD

ENV KERNELMCP_DIR=/kernelmcp

USER root
RUN rm -rf "${KERNELMCP_DIR}"

RUN --mount=type=bind,source=.git,target=/tmp/kernelmcp.git,readonly \
    git clone /tmp/kernelmcp.git "${KERNELMCP_DIR}" && \
    cd "${KERNELMCP_DIR}" && \
    git checkout "${REPO_REF}" && \
    git submodule update --init --recursive && \
    chown -R "${USERNAME}:${USERNAME}" "${KERNELMCP_DIR}"

USER ${USERNAME}
WORKDIR ${KERNELMCP_DIR}
RUN ./install.sh
